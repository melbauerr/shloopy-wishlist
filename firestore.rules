rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared lists — either of you can read and write any item.
    match /wishlist_items/{itemId} {
      allow read, write: if request.auth != null
        && (
          request.auth.uid == "lUlrBxUSMtg2M4oIscxeybT8wOJ2"
          || request.auth.uid == "YiseNexpFLP8GP4OLQYDb7KV4Li2"
        );
    }

    // Secret stash — only the item's own owner (by uid) can read
    // or delete it, and only that same uid can create it for
    // themselves. This is checked by Firestore itself, so it holds
    // even if the app's UI were bypassed entirely.
    match /secret_items/{itemId} {
      allow read, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && (
          request.auth.uid == "lUlrBxUSMtg2M4oIscxeybT8wOJ2"
          || request.auth.uid == "YiseNexpFLP8GP4OLQYDb7KV4Li2"
        );
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && (
          request.auth.uid == "lUlrBxUSMtg2M4oIscxeybT8wOJ2"
          || request.auth.uid == "YiseNexpFLP8GP4OLQYDb7KV4Li2"
        );
    }
  }
}